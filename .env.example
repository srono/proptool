# Supabase (local dev defaults)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# WhatsApp (360dialog)
DIALOG_360_API_KEY=your-360dialog-api-key
DIALOG_360_WEBHOOK_SECRET=your-webhook-secret

# Meta (Facebook Lead Ads)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-webhook-verify-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=cinvea.com
EMAIL_INBOUND_DOMAIN=cinvea.com


# URA Data Service API
URA_ACCESS_KEY=your-ura-access-key

# AI (for Area Insight generation — hybrid mode)
OPENAI_API_KEY=sk-xxx
# LLM model for reply suggestion generation (default: gpt-4o-mini)
# SUGGESTION_MODEL=gpt-4o-mini
# LLM model for area insight generation (default: gpt-4o-mini)
# INSIGHTS_MODEL=gpt-4o-mini
# LLM model for ad-copy (default: gpt-4o-mini)
# AD_COPY_MODEL=gpt-5.4-mini

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@cinvea.com
